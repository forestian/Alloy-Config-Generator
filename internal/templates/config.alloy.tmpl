// Grafana Alloy starter configuration generated by alloygen.
//
// Mode: {{ .Mode }}
// Profile: {{ .Profile }}
// Cluster label: {{ .ClusterName }}
//
// This file is intentionally conservative and readable. Review endpoints,
// scrape intervals, labels, RBAC, and resource sizing before production use.
{{- if .IsProduction }}
// This is a production-oriented starter configuration, not a fully production-certified setup.
{{- end }}

logging {
  level  = "info"
  format = "logfmt"
}

{{- if .IsKubernetes }}

// Kubernetes pod discovery used by the enabled pipelines.
// Add namespace filtering here if you only want Alloy to observe selected namespaces.
discovery.kubernetes "pods" {
  role = "pod"
}
{{- if .HasLogs }}

// Logs pipeline: Kubernetes pod logs are forwarded to Loki.
// Endpoint: {{ .LokiURL }}
// Labels attached here: namespace, pod, container, app, and cluster.
// Avoid high-cardinality labels. Keep request_id, user_id, trace_id, path, and similar values in the log body.
discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_label_app"]
    separator     = ";"
    regex         = ";?([^;]+).*"
    target_label  = "app"
  }

  rule {
    target_label = "cluster"
    replacement  = "{{ .ClusterName }}"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pod_logs.output
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "{{ .LokiURL }}"
  }
}
{{- end }}
{{- if .HasMetrics }}

// Metrics pipeline: Kubernetes pods with prometheus.io/scrape=true are scraped and remote_written.
// Endpoint: {{ .RemoteWriteURL }}
// Review scrape intervals, relabeling, and the remote_write endpoint for your environment.
// The external cluster label is attached to every written series.
discovery.relabel "pod_metrics" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
    target_label  = "__metrics_path__"
    regex         = "(.+)"
  }

  rule {
    source_labels = ["__address__", "__meta_kubernetes_pod_annotation_prometheus_io_port"]
    regex         = "([^:]+)(?::\\d+)?;(\\d+)"
    replacement   = "$1:$2"
    target_label  = "__address__"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    target_label = "cluster"
    replacement  = "{{ .ClusterName }}"
  }
}

prometheus.scrape "kubernetes_pods" {
  targets         = discovery.relabel.pod_metrics.output
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "{{ .RemoteWriteURL }}"
  }

  external_labels = {
    cluster = "{{ .ClusterName }}",
  }
}
{{- end }}
{{- else }}

// Standalone mode avoids Kubernetes discovery. These starters are useful for
// local labs, small hosts, or adapting the generated config into another runtime.
{{- if .HasLogs }}

// Logs pipeline: local container-style log files are forwarded to Loki.
// Endpoint: {{ .LokiURL }}
local.file_match "logs" {
  path_targets = [{
    __path__ = "/var/log/pods/*/*/*.log",
    cluster  = "{{ .ClusterName }}",
  }]
}

loki.source.file "logs" {
  targets    = local.file_match.logs.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "{{ .LokiURL }}"
  }
}
{{- end }}
{{- if .HasMetrics }}

// Metrics pipeline: static localhost scrape starter with remote_write.
// Endpoint: {{ .RemoteWriteURL }}
prometheus.scrape "static" {
  targets = [{
    __address__ = "localhost:9100",
    cluster     = "{{ .ClusterName }}",
  }]

  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "{{ .RemoteWriteURL }}"
  }

  external_labels = {
    cluster = "{{ .ClusterName }}",
  }
}
{{- end }}
{{- end }}
{{- if .HasTraces }}

// Traces pipeline: OTLP gRPC and HTTP are received locally and forwarded to {{ .TraceBackendName }}.
// Endpoint: {{ .TraceEndpoint }}
// Review client TLS, authentication, and network policy requirements before production use.
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.default.input]
  }
}

otelcol.exporter.otlp "default" {
  client {
    endpoint = "{{ .TraceEndpoint }}"

    tls {
      insecure = true
    }
  }
}
{{- end }}

