# Grafana Alloy Helm values generated by alloygen.
# Profile: {{ .Profile }}
# Namespace used by install script: {{ .Namespace }}
{{- if .IsProduction }}
# This is a production-oriented starter configuration, not a fully production-certified setup.
# Review RBAC, resource limits, tolerations, affinity, topology spread, and securityContext.
{{- else }}
# Dev profile uses modest resource requests for labs, test clusters, and PoCs.
{{- end }}

alloy:
  configMap:
    create: true
    content: |-
{{ indent 6 .ConfigAlloy }}

controller:
{{- if .IsKubernetes }}
  type: daemonset
{{- else }}
  type: deployment
{{- end }}

serviceAccount:
  create: true

rbac:
  create: true

resources:
{{- if .IsProduction }}
  requests:
    cpu: 250m
    memory: 256Mi
  limits:
    cpu: 1000m
    memory: 1Gi
{{- else }}
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 500m
    memory: 512Mi
{{- end }}

# Production review reminders:
# - Keep credentials out of this file; use Kubernetes Secrets or Helm secret management.
# - Confirm Alloy has only the RBAC it needs for the enabled pipelines.
# - Review resource sizing after observing real ingestion volume.
# - Add tolerations, affinity, securityContext, and network policies for your cluster standards.
# - Confirm endpoints before applying to shared or production clusters.

